# PART 7 — TypeScript in React Native

TypeScript adds a type system on top of JavaScript. It catches errors before your app runs.

## Basic types

```tsx
// Primitives
const name: string = 'Shivansh';
const age: number = 20;
const isActive: boolean = true;
const nothing: null = null;

// Arrays
const names: string[] = ['Alice', 'Bob'];
const numbers: number[] = [1, 2, 3];

// Objects — use interfaces
interface User {
  id: string;
  name: string;
  age?: number;  // ← ? means optional
}

const user: User = { id: '123', name: 'Alice' };

// Union types — can be one of several types
type Status = 'pending' | 'approved' | 'rejected';
let taskStatus: Status = 'pending';
taskStatus = 'invalid'; // ← TypeScript error!

// Generics — reusable types with a placeholder
function getFirst<T>(arr: T[]): T {
  return arr[0];
}
getFirst<string>(['a', 'b']); // returns string
getFirst<number>([1, 2, 3]);  // returns number
```

## Typing component props

```tsx
// Define the shape of props
interface CardProps {
  title: string;
  subtitle?: string;    // optional
  onPress: () => void;  // function that returns nothing
  count: number;
}

// Use them
function Card({ title, subtitle, onPress, count }: CardProps) {
  return (
    <TouchableOpacity onPress={onPress}>
      <Text>{title}</Text>
      {subtitle && <Text>{subtitle}</Text>}
      <Text>{count}</Text>
    </TouchableOpacity>
  );
}

// TypeScript will error if you forget required props
<Card title="Hello" onPress={() => {}} count={5} />
```

