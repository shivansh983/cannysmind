# PART 9 — Async/Await and API calls

All network requests are asynchronous — they take time, so you can't block the UI waiting for them.

```tsx
// async/await is syntactic sugar over Promises
// WRONG — synchronous thinking (doesn't work for API calls):
const data = fetch('https://api.example.com/tasks'); // returns a Promise, not data

// CORRECT — wait for the Promise to resolve:
async function loadTasks() {
  try {
    const response = await fetch('https://api.example.com/tasks');
    // response is now the HTTP response object

    const data = await response.json();
    // data is now the parsed JSON object

    console.log(data.tasks); // ['task1', 'task2']
  } catch (error) {
    // any error (network down, server error, JSON parse error) lands here
    console.error('Failed:', error);
  }
}

// The full pattern used in your app:
useEffect(() => {
  // useEffect can't be async itself, so we define async inside
  const load = async () => {
    setLoading(true);
    try {
      const res = await fetch(`${API_BASE}/tasks`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${cookie}`,
        },
      });

      if (!res.ok) {
        // HTTP error (404, 401, 500)
        throw new Error(`HTTP ${res.status}`);
      }

      const json = await res.json();
      setTasks(json.tasks);
    } catch (e) {
      Alert.alert('Error', 'Could not load tasks');
    } finally {
      setLoading(false); // always runs, success or failure
    }
  };

  load();
}, []);
```

